# Copy this file to your server-side environment manager.
# Do not commit real secrets.

FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_VERIFICATION_TOKEN=your_event_verification_token

# Optional but recommended when enabled in Feishu event subscriptions.
FEISHU_ENCRYPT_KEY=
FEISHU_EVENT_SIGNING_KEY=

# Comma-separated open_id values. Keep this set for a personal command-executing bot.
FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxxx

# MewCode execution settings.
FEISHU_WORK_DIR=/srv/mewcode/workspace
FEISHU_MEWCODE_CONFIG=/srv/mewcode/app/.mewcode/config.yaml
FEISHU_PERMISSION_MODE=dontAsk
FEISHU_MAX_ITERATIONS=20

# Local service binding. Put Nginx/Caddy in front of this for HTTPS on a server.
FEISHU_HOST=127.0.0.1
FEISHU_PORT=8787
FEISHU_REPLY_MAX_CHARS=3500
FEISHU_ACK_TEXT=已收到，正在执行。

